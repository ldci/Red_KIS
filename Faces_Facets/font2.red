#!/usr/local/bin/red-view
Red [needs: view]
;--Status: OK
view [
	title "Fonts"
	text "hello" font-name "arial" font-size 18 font-color red bold
	text "hello" font-name "arial" font-size 18 font-color blue
	text "hello" font-name "arial" font-size 15 font-color green strike
	text "hello" font-name "arial" font-size 12 font-color cyan underline
]