
red: context [#include %$ROOT-PATH$runtime/definitions.reds #include %$ROOT-PATH$runtime/macros.reds #include %$ROOT-PATH$runtime/structures.reds
cell!: alias struct! [
    header [integer!]
    data1 [integer!]
    data2 [integer!]
    data3 [integer!]
]
series-buffer!: alias struct! [
    flags [integer!]
    node [node-handle!]
    size [integer!]
    offset [cell!]
    tail [cell!]
]
root-base: as cell! 0
get-root: func [
    idx [integer!]
    return: [red-block!]
] [
    as red-block! root-base + idx
]
get-root-node: func [
    idx [integer!]
    return: [node-handle!]
    /local
    obj [red-object!]
] [
    obj: as red-object! get-root idx
    obj/ctx
]
